# ---------------------------------------------------------------------------
# One OpenAI-compatible endpoint serves all four frameworks.
# Copy to `.env` and pick a profile.
# ---------------------------------------------------------------------------

# --- Profile: ollama (default, free, fully local) --------------------------
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull qwen2.5:3b-instruct
#   ollama serve
LLM_PROFILE=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=ollama

# --- Profile: anthropic (OpenAI-compatible endpoint) -----------------------
# LLM_PROFILE=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-...

# --- Profile: groq (OpenAI-compatible, generous free tier, very fast) ------
# Get a key at https://console.groq.com/keys. A far roomier free tier than
# Gemini's, which matters here because every chat question costs two calls.
# Pick a model that supports tool calling — check the live list with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_KEY"
# LLM_PROFILE=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# --- Profile: gemini (OpenAI-compatible endpoint, has a free tier) ---------
# Verified working with this project. Note the free tier is tight: 5 requests
# per minute and 20 per day per model, and each chat question costs two calls
# (decide the tool, then answer), so expect to be paced.
# Gemini 3.x models are NOT usable here: they require a `thought_signature` on
# function-call parts that the OpenAI-compatible clients do not send, so
# tool-calling fails with a 400. Stay on 2.5.
# LLM_PROFILE=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...

# ---------------------------------------------------------------------------
# Real mail (Gmail)
# ---------------------------------------------------------------------------
# Every message is always written to `.runs/outbox/*.eml`. Transmitting one
# additionally needs SMTP_HOST set AND the `--send` flag AND — for anything
# customer-facing — the recipient to pass the allowlist below.
#
# Gmail needs an App Password, not your account password: turn on 2-Step
# Verification, then https://myaccount.google.com/apppasswords. Google shows it
# as four groups of four; paste it here with the spaces removed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=dheerajreddy035@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop

# Who the mail appears to come from. Gmail rewrites this to SMTP_USER unless the
# address is a verified alias, so the simplest thing is to keep them the same.
# ONBOARDING_FROM_EMAIL=dheerajreddy035@gmail.com

# Where every internal task list is sent. One address, set once.
# ONBOARDING_SUPPORT_EMAIL=dheerajreddy035@gmail.com

# WHO MAY RECEIVE CUSTOMER MAIL. Empty by default, which means nothing
# customer-facing is transmitted at all — a form accepts whatever address is
# typed into it, and mail to a stranger cannot be recalled.
#
#   ONBOARDING_ALLOWED_RECIPIENTS=a@gmail.com,b@gmail.com
#       Only those addresses receive real mail. Everything else still lands in
#       the outbox, and the page says plainly that it was refused.
#
#   ONBOARDING_ALLOWED_RECIPIENTS=*
#       The demo setting: the welcome email really goes to whatever address was
#       typed into the form. Live inboxes, and a real stranger if you mistype.
#       The page shows an amber "sending to any address" badge while this is on,
#       so the risk is never invisible.
# ONBOARDING_ALLOWED_RECIPIENTS=*

# --- Optional ---------------------------------------------------------------
# Force the regex-only PII engine even when the spaCy model is installed.
# ONBOARDING_FORCE_REGEX_PII=1
