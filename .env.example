# ---------------------------------------------------------------------------
# One OpenAI-compatible endpoint serves all three frameworks.
# Copy to `.env` and pick a profile.
# ---------------------------------------------------------------------------

# --- Profile: ollama (default, free, fully local) --------------------------
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull qwen2.5:3b-instruct
#   ollama serve
LLM_PROFILE=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=ollama

# --- Profile: anthropic (OpenAI-compatible endpoint) -----------------------
# LLM_PROFILE=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-...

# --- Profile: gemini (OpenAI-compatible endpoint, has a free tier) ---------
# Verified working with this project. Note the free tier is tight: 5 requests
# per minute and 20 per day per model, and each chat question costs two calls
# (decide the tool, then answer), so expect to be paced.
# Gemini 3.x models are NOT usable here: they require a `thought_signature` on
# function-call parts that the OpenAI-compatible clients do not send, so
# tool-calling fails with a 400. Stay on 2.5.
# LLM_PROFILE=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...

# --- Optional ---------------------------------------------------------------
# Force the regex-only PII engine even when the spaCy model is installed.
# ONBOARDING_FORCE_REGEX_PII=1
